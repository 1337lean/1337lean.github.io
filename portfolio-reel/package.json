{
  "name": "portfolio-reel",
  "version": "1.0.0",
  "description": "Animated portfolio systems reel for lean.",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.503",
    "@remotion/google-fonts": "4.0.503",
    "@remotion/transitions": "4.0.503",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.503"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.503",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render:mp4": "remotion render PortfolioReel ../assets/reel/lean-reel.mp4 --codec=h264 --crf=24 --pixel-format=yuv420p --concurrency=50%",
    "render:webm": "remotion render PortfolioReel ../assets/reel/lean-reel.webm --codec=vp9 --crf=32 --concurrency=50%",
    "render:poster": "remotion still PortfolioReel ../assets/reel/lean-reel-poster.jpg --frame=330 --image-format=jpeg",
    "render:site": "npm run render:mp4 && npm run render:webm && npm run render:poster",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
}
